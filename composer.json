{
	"name": "storepress/base-plugin",
	"description": "StorePress Base Plugin",
	"version": "1.0.0",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"keywords": [
		"gutenberg",
		"wordpress",
		"storepress",
		"plugin"
	],
	"homepage": "https://github.com/EmranAhmed/storepress-base-plugin#readme",
	"authors": [
		{
			"name": "Emran Ahmed",
			"email": "emran@storepress.com"
		},
		{
			"name": "StorePress Inc.",
			"email": "storepresshq@gmail.com"
		}
	],
	"require": {
		"automattic/jetpack-autoloader": "^v6.0",
		"storepress/admin-utils": "^4.1"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^v1.2",
		"woocommerce/woocommerce-sniffs": "^2.0.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1.7|^3.0.0-alpha",
		"php-stubs/woocommerce-stubs": "^v11.2",
		"phpstan/extension-installer": "^1.4.3",
		"phpstan/phpstan": "^2.3",
		"szepeviktor/phpstan-wordpress": "^v2.0",
		"wp-cli/i18n-command": "^v3.0",
		"wp-coding-standards/wpcs": "^3.4",
		"phpunit/phpunit": "^8.5|^9.6",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^4.0",
		"plugin-check/phpcs-sniffs": "@dev"
	},
	"repositories": [
		{
			"type": "path",
			"url": "./wp-plugin-check/plugin-check/phpcs-sniffs",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload": {
		"psr-4": {
			"StorePress\\Base\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PluginTests\\": "tests/php/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"lock": true,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"test-install": "bash bin/install-wp-tests.sh wordpress_test root 'root' 127.0.0.1 latest",
		"test": "./vendor/bin/phpunit --testdox",
		"test:unit": "./vendor/bin/phpunit --testsuite Unit  --testdox",
		"test:integration": "./vendor/bin/phpunit --testsuite Integration  --testdox",
		"test:coverage": "./vendor/bin/phpunit --coverage-html coverage",
		"phpstan" : "./vendor/bin/phpstan --memory-limit=2G",
		"phpstan-report" : "./vendor/bin/phpstan --memory-limit=4G -vvv > phpstan-report.txt",
		"phpstan-clear" : "./vendor/bin/phpstan clear-result-cache",
		"format" : "./vendor/bin/phpcbf --standard=phpcs.xml",
		"lint-report" : "./vendor/bin/phpcs --standard=phpcs.xml --report-summary --report-source --ignore-annotations --report-full=phpcs-report.txt",
		"lint" : "./vendor/bin/phpcs --standard=phpcs.xml --report=full"
	}
}
